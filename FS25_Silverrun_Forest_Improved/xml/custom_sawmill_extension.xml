<!--
    FS25_Silverrun_Forest_Improved - Runtime extension for the Silverrun old sawmill.
    Read by scripts/SawmillAnimationInjector.lua. The map files are never modified.

    Node names come from the map itself:
      placeables/brandless/productionPointsGeneric/sawmillOld/sawmillOldTriggers.xml / .i3d
      placeables/brandless/productionPointsGeneric/sawmillOldConveyors/sawmillOldConveyors.i3d
-->
<sawmillExtension>
    <!-- Target: the preplaced old sawmill (map/config/placeables.xml, position="327 43 -512") -->
    <productionPoint uniqueId="sawmillOld" configFileSuffix="sawmillOld/sawmillOldTriggers.xml">

        <animationNodes>
            <!-- Rollers use $data/shaders/vtxRotateShader.xml (map default "rotation" = 0 8 0 0).
                 rotAxis: 1 = X, 2 = Y, 3 = Z (component of the shader parameter).
                 The roller meshes spin around their local Y axis, so 2 is correct here. -->
            <rotationNode shapeName="satrtRot"  shaderParameter="rotation" rotSpeed="15" rotAxis="2" />
            <rotationNode shapeName="middleRot" shaderParameter="rotation" rotSpeed="15" rotAxis="2" />

            <!-- Belts use $data/shaders/uvScrollShader.xml (map default "offsetUV" = 0 0 0.1 0).
                 speedScale multiplies the map's original scroll speed. -->
            <scrollNode shapeName="uvScroll" shaderParameter="offsetUV" speedScale="1.0" />

            <!-- true: rollers and belts stop while no production is running -->
            <syncWithProduction value="true" />
        </animationNodes>

        <!-- The pond trigger already exists in the map (node "woodTrigger",
             world position approx. x=297 y=35 z=-443). This switches it to automatic collection. -->
        <woodTrigger triggerNodeName="woodTrigger" autoCollect="true" intervalMs="1000" />

        <!-- Yellow wood chipper next to the pond (node "woodTriggerCrusher"). In the map it only adds the logs
             as WOOD to the sawmill storage ("Sell wood"). With mode="chips" the logs become WOODCHIPS
             in the sawmill storage instead, and the map's heap spawner puts them on the chip heap.
             chipsScale multiplies the base game wood crusher yield (liters chips per liter wood of the species).
             autoChip: logs are chipped automatically after they land in the chipper (like FS22). -->
        <chipper triggerNodeName="woodTriggerCrusher" mode="chips" autoChip="true" intervalMs="1500" chipsScale="1.0" />

        <!-- Woodchip heap: in the map the heap spawner creates chips for free while the sawmill's own woodchip
             storage is never emptied, so the sawmill stops when it reaches 50 000 l.
             With drainToHeap="true" the map's heap spawner keeps working at its own place and rate, but it only
             gets the chips that are in the storage, and what it drops is taken from the storage.
             If the spawner does not behave as expected, the mod falls back to its own tipping below the pipe
             (outletNodeName, litersPerHour, maxHeapHeight, tickMs are used for that fallback only).
             debug: log line every 30 s. -->
        <chipHeap drainToHeap="true" litersPerHour="2000" maxHeapHeight="8" tickMs="250" outletNodeName="effectSmoke" debug="true" />

        <!-- Log lift: one log after another leaves the pond, runs over the chain, up the ramp into the hall.
             The map ships 5 trunk models (logAnimNode1-5) and the clip from FS22, but FS25 no longer plays
             the <animation> block of the selling station. The keyframes below are read 1:1 from the map's
             sawmillOldAnimation.i3d.anim (clip "logAnimationClipSource", 16.7 s) and are played by the script.
             transSpeed: playback speed (map value speedScale="0.5" -> about 33 s per log).
             waitThresholdAnimTime: clip time in ms a log must have travelled before the next one starts
             (map value 3400). -->
        <logLift enabled="true" nodePrefix="logAnimNode" nodeCount="5" transSpeed="0.5" waitThresholdAnimTime="3400">
